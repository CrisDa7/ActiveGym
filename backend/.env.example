# Copia este archivo como ".env" y ajusta los valores.
PORT=4000
NODE_ENV=development

# Origen permitido del frontend (CORS). En producción pon tu dominio real.
CLIENT_ORIGIN=http://localhost:5173

# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/activegym
# En la nube (Render, Railway, Neon...) normalmente se necesita SSL: true
DB_SSL=false

# Secreto para firmar los tokens. Genera uno largo y aleatorio:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=8h

# Cuántos días antes del vencimiento se muestra la alerta
ALERT_DAYS_BEFORE=2

# Código de país para armar los enlaces de WhatsApp (Ecuador = 593)
WHATSAPP_COUNTRY_CODE=593

# Primer usuario administrador (lo crea: npm run db:seed)
ADMIN_NOMBRE=Nombre
ADMIN_APELLIDO=Apellido
ADMIN_CELULAR=0990000000
ADMIN_CORREO=admin@correo.com
ADMIN_PASSWORD=UnaClaveSegura123!

# Cookie de sesión. Si frontend y backend están en dominios distintos al desplegar,
# usa COOKIE_SAMESITE=none (requiere HTTPS).
COOKIE_SAMESITE=lax
# Zona horaria del gimnasio (para calcular "hoy" y los días restantes)
APP_TIMEZONE=America/Guayaquil
